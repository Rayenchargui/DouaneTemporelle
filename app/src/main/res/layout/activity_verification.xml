<?xml version="1.0" encoding="utf-8"?>
<!-- RACINE : LinearLayout horizontal -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:weightSum="1.0"
    android:background="#000000">

    <!-- IMAGE (0.3) -->
    <ImageView
        android:id="@+id/img_profil_rl"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:background="@drawable/arriere" />

    <!-- TEXTES (0.7) -->
    <RelativeLayout
        android:id="@+id/rl_droite_rl"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:background="#121212">

        <!--titre-->
        <TextView
            android:id="@+id/tv_titre_rl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="PROFIL VOYAGEUR"
            android:fontFamily="sans-serif-smallcaps"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true" />

        <!--  vertical  -->
        <LinearLayout
            android:id="@+id/ll_donnees_rl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerVertical="true">

            <!--  NOM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <!-- La largeur reste en dp, le texte passe en sp -->
                <TextView
                    android:id="@+id/tv_label_nom_rl"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:paddingLeft="16dp"
                    android:text="NOM :"
                    android:fontFamily="sans-serif-smallcaps"
                    android:textColor="#FF0000"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_nom_rl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="....."
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!--  AGE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_label_age_rl"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:paddingLeft="16dp"
                    android:text="AGE :"
                    android:fontFamily="sans-serif-smallcaps"
                    android:textColor="#FF0000"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_age_rl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="....."
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!--  MOTIF -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_label_motif_rl"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:paddingLeft="16dp"
                    android:text="MOTIF :"
                    android:fontFamily="sans-serif-smallcaps"
                    android:textColor="#FF0000"
                    android:textSize="19sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_motif_rl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="....."
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!--  BOUTONS -->
        <LinearLayout
            android:id="@+id/ll_boutons_rl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentBottom="true">

            <Button
                android:id="@+id/btn_approuver_rl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Approuver le saut temporel"
                android:textColor="#FFFFFF"
                android:background="@color/bouton_vert"
                android:textStyle="bold"
                android:onClick="approuver" />

            <!-- TextView bech na3mel espace entre les boutons-->
            <TextView
                android:id="@+id/tv_espace_rl"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:text="" />

            <!-- Espace vide ta7t refuser -->
            <Button
                android:id="@+id/btn_refuser_rl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Refuser (Risque de paradoxe)"
                android:textColor="#FFFFFF"
                android:background="@color/bouton_rouge"
                android:textStyle="bold"
                android:onClick="refuser" />
        </LinearLayout>

    </RelativeLayout>
</LinearLayout>